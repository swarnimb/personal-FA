# Add required environment variables here as they are discovered during planning and implementation.
# Never put real values in this file — it is committed to version control.
# Copy to .env and fill in real values locally.

# Database
DATABASE_URL=

# SimpleFin Bridge
SIMPLEFIN_ACCESS_URL=

# Coinbase Advanced Trade API (read-only)
COINBASE_API_KEY=
COINBASE_API_SECRET=

# Kraken REST API (read-only — Query Funds scope only)
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Encryption key for crypto API keys at rest (32-byte hex string for AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Cron sync hour (0-23, 24-hour clock). Optional — defaults to 2 (2:00 AM) if not set.
# CRON_HOUR=2
